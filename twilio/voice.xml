  <Say language="es-MX">Gracias por llamar a Luxucleen. Un momento, le comunicamos.</Say>
  <Dial timeout="25" callerId="+18043311128" action="https://luxucleen.com/twilio/missed.xml" method="GET">
    <Number>+18049565472</Number>
  </Dial>
</Response>
